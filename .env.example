# Copy to .env only when configuring your own services. Never commit real values.
# Manual text intake does not need any of these settings.
MR_WHITE_THREADS_APP_ID=
MR_WHITE_THREADS_APP_SECRET=
# Must exactly match your Meta app's registered callback. Verify localhost/HTTPS support there.
MR_WHITE_THREADS_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters. Preserve securely; losing it requires reconnecting.
MR_WHITE_CREDENTIAL_KEY=
# Optional read-only development token; never used as authorization to publish.
MR_WHITE_THREADS_READ_TOKEN=
# Optional PAID IG provider. Leave empty until coverage and spending limit are approved.
MR_WHITE_APIFY_TOKEN=

# Optional: absolute path to an already installed local Codex CLI. No API key required.
MR_WHITE_CODEX=
